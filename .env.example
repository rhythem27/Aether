# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-secret-key

# Database Connections
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aether
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# LLM & AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# External Data API Keys (MCP Data Sources)
EDGAR_API_KEY=your_sec_edgar_user_agent_email@domain.com
CRUNCHBASE_KEY=your_crunchbase_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000
